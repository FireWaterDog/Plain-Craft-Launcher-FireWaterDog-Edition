<Window x:Class="MyLoginBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="微软登录" Width="480" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FBFBFB" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <wv2:WebView2 x:Name="Web" />
        <Border x:Name="LoadingMask" Background="#FBFBFB" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20">
            <StackPanel>
                <TextBlock Text="正在打开微软登录页面……" FontSize="15" Foreground="#FF5C5C5C" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
